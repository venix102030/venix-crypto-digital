
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Venix Crypto Digital</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#080d18;
 color:#fff;
 font-family:Arial,sans-serif;
}
header{
 background:#111a2b;
 padding:22px;
 border-bottom:1px solid #26344b;
}
.logo{font-size:24px;font-weight:bold;color:#f7931a}
.logo span{color:white}
.container{padding:18px;max-width:700px;margin:auto}
.card{
 background:#121e31;
 border:1px solid #263852;
 border-radius:15px;
 padding:20px;
 margin-bottom:16px;
}
.label{color:#91a3bb;font-size:13px}
.value{font-size:27px;font-weight:bold;margin-top:10px}
.orange{color:#f7931a}
.grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
}
button{
 width:100%;
 padding:15px;
 border:0;
 border-radius:10px;
 background:#f7931a;
 color:#101827;
 font-size:16px;
 font-weight:bold;
 margin-top:15px;
}
button:disabled{opacity:.5}
.status{color:#37d996;font-weight:bold}
nav{
 display:flex;
 justify-content:space-around;
 background:#111a2b;
 padding:17px 5px;
 position:sticky;
 bottom:0;
}
nav a{color:#aab8cb;text-decoration:none;font-size:12px}
.small{font-size:12px;color:#91a3bb}
</style>
</head>
<body>

<header>
 <div class="logo">VENIX <span>CRYPTO DIGITAL</span></div>
 <p class="small">Sua plataforma de ativos digitais</p>
</header>

<main class="container">

 <div class="card">
  <div class="label">SALDO TOTAL</div>
  <div class="value orange" id="balance">0.00000000 BTC</div>
  <p class="small">Painel de demonstração</p>
 </div>

 <div class="grid">
  <div class="card">
   <div class="label">HASHRATE</div>
   <div class="value">0 TH/s</div>
  </div>
  <div class="card">
   <div class="label">MINERAÇÃO</div>
   <div class="value status">INATIVA</div>
  </div>
 </div>

 <div class="card">
  <h3>Mineração Bitcoin</h3>
  <p class="small">Ambiente de simulação. Nenhuma mineração real está sendo executada.</p>
  <div class="label">Tempo de atividade</div>
  <div class="value" id="timer">00:00:00</div>
  <button onclick="startDemo()" id="start">INICIAR SIMULAÇÃO</button>
  <button onclick="stopDemo()" style="background:#263852;color:white">PARAR</button>
 </div>

 <div class="card">
  <h3>Conexão com mineradoras</h3>
  <p class="small">Integração com provedores externos</p>
  <p class="status">● Aguardando configuração</p>
  <p class="small">Nenhuma mineradora conectada.</p>
 </div>

 <div class="card">
  <h3>Segurança da conta</h3>
  <p class="status">● Interface protegida</p>
  <p class="small">A autenticação e a proteção de dados serão implementadas na próxima etapa.</p>
 </div>

</main>

<nav>
 <a href="#">⌂<br>Início</a>
 <a href="#">₿<br>Bitcoin</a>
 <a href="#">▣<br>Mineração</a>
 <a href="#">⚙<br>Configurações</a>
</nav>


<script>
let seconds = 0;
let interval = null;

function updateTimer() {
  let h = String(Math.floor(seconds / 3600)).padStart(2, '0');
  let m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
  let s = String(seconds % 60).padStart(2, '0');

  document.getElementById('timer').textContent =
    h + ':' + m + ':' + s;
}

function startDemo() {
  if (interval !== null) return;

  interval = setInterval(() => {
    seconds++;
    updateTimer();
  }, 1000);
}

function stopDemo() {
  clearInterval(interval);
  interval = null;
}
</script>

</body>
</html>


